[Unit]
Description=Kalori uygulamasi (SalimBabaninZayiflamaUygulamasi)
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/kalori
ExecStart=/home/ubuntu/kalori/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8096 --proxy-headers --no-server-header
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
